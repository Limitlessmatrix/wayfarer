press a                 # job board
wait 300
shot j1_home_board
press a                 # accept first job
wait 300
press a                 # dismiss popup
wait 200
shot j2_home_board_taken
press b
wait 200
press b
wait 200
press b                 # leave shipyard, map
wait 500
press c                 # ship menu
wait 200
press down 4            # contracts
press a
wait 300
shot j3_contracts_popup
press a
wait 200
press b
wait 300
usb DBG POI 3
wait 200
press a                 # enter outpost 3
wait 500
press c
wait 200
press down
