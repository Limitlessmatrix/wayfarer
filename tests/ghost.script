# Single core: fake a room and a peer over the UART, check ghost rendering and the fleet popup.
wait 2500
uart $MP ROOM 777 1
wait 200
press a
wait 300
hold a 3500
press a
wait 300
hold a 3500
press a
wait 1500
press b
wait 1000
uart $MP HELLO ZZZZZ Ghost_Rider D
uart $MP POS ZZZZZ Ghost_Rider D 0 1 3 3 5 900 2 0 0
uart $MP POS YYYYY Red_Five A 1 -1 1 2 3 400 5 0 0
wait 600
peers
shot ghost_map
press c
wait 400
shot ghost_fleet
press a
wait 300
uart $MP DONE YYYYY Red_Five 4200
wait 300
press c
wait 400
shot ghost_fleet2
